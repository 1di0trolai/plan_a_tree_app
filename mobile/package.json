{
  "name": "pat-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "overrides": {
    "react-dom": "$react"
  },
  "engines": {
    "node": "^24.3.0 || >=26.0.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "^58.0.0",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "npx eas-cli@latest build --platform android --profile personal",
    "build:ios-simulator": "npx eas-cli@latest build --platform ios --profile ios-simulator",
    "credentials:android": "npx eas-cli@latest credentials --platform android",
    "export:mobile": "expo export --platform android --platform ios --output-dir .expo/export",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "doctor": "npx expo-doctor",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "test:critical": "tsx --test tests/appEconomyStore.test.ts tests/cloudStorage.test.ts tests/musicPlaybackFlow.test.ts tests/plantChatUI.test.ts"
  },
  "private": true
}
