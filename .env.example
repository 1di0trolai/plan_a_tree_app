# Windows Authentication; local Node.js tools only, never EXPO_PUBLIC_*.
DB_SERVER=localhost
DB_NAME=PAT
# Account authentication database; other database tools still use DB_NAME.
AUTH_DB_NAME=PAT

# Social login (server only). Google Web client ID, not a client secret.
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Public Expo IDs can live in mobile/.env; never put App Secret there.

# Password recovery email (server only; never EXPO_PUBLIC_* or committed secrets).
# Gmail requires 2-Step Verification and a dedicated App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Bare sender email; defaults to SMTP_USER. Gmail must authorize this sender.
SMTP_FROM=

# Private administrator website: comma-separated exact HTTPS origins, no /admin suffix.
# Localhost on API_PORT is allowed for local setup; no public signup/default password.
ADMIN_ORIGINS=https://your-computer.your-tailnet.ts.net

# Gemini AI proxy (server only). Choose a vision + structured-output model you
# have access to; no paid model is selected automatically. Never EXPO_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=35000
API_HOST=127.0.0.1
API_PORT=3001
# Developer bearer token, >=24 random characters when binding to your LAN.
# Required for AI proxy requests, not public account login/recovery routes.
# Account operations use their own SQL-backed sessions where applicable.
API_AUTH_TOKEN=
