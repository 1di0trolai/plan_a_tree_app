{
  "expo": {
    "name": "PAT",
    "slug": "pat-plant-adventure",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo/pat-icon.png",
    "scheme": "pat",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBFFF8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pat.plantadventure",
      "infoPlist": {
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pat.plantadventure",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FBFFF8",
        "foregroundImage": "./assets/logo/pat-adaptive-foreground.png",
        "monochromeImage": "./assets/logo/pat-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/pat-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBFFF8"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PAT cần quyền Camera để bạn chụp ảnh, nhận diện và theo dõi cây thật.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PAT cần quyền truy cập thư viện ảnh để bạn tạo hồ sơ và theo dõi cây thật.",
          "cameraPermission": "PAT cần quyền Camera để bạn chụp ảnh, tạo hồ sơ và kiểm tra cây thật.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.958002070789-b7ja6qhuagttf82dv84k9fsrs2eqg9su"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "28543453142004211",
          "displayName": "PAT",
          "clientToken": "741979306f3790f8c6cf581db6af3f44",
          "scheme": "fb28543453142004211",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b3d1002-d264-4da3-ad79-94c1496b7834"
      }
    },
    "owner": "jaskai"
  }
}
