# Local-development backend only. Restart Expo after changing these values.
# A real phone needs your computer's LAN IP, NOT localhost.
EXPO_PUBLIC_PAT_API_URL=http://192.168.1.10:3001
# Same developer token as API_AUTH_TOKEN in the root .env. Bundled in the app:
# this is NOT a production secret or a substitute for per-user authentication.
EXPO_PUBLIC_PAT_API_TOKEN=
# Native sign-in: all of these values are public and included in the app.
# Android client ID binds package + signing SHA-1 in Google Cloud Console.
# The Web client ID is the ID-token audience verified by the PAT server.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
# NEVER place GEMINI_API_KEY or SQL credentials in EXPO_PUBLIC_* variables.
